{
  "description": "After a .sv/.svh edit, tell the model what svstyle reports (never blocks)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/post_edit.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
