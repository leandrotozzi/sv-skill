# Verible lint config - lowRISC-aligned SystemVerilog RTL house style.
# Verified against verible-verilog-lint v0.0-3946-g851d3ff4.
# NOTE: this file is a DELTA on --ruleset (default "default"), not a replacement.
# All 61 rules of this build are listed explicitly so the result is hermetic.

# --- combinational / sequential logic ---
always-comb
always-comb-blocking
always-ff-non-blocking=catch_modifying_assignments:false;waive_for_locals:true
case-missing-default

# --- naming: ports, signals, flops, types, params, macros ---
port-name-suffix
signal-name-style=style_regex:[a-z_0-9]+
# Checks the output side only: a flop is named _q, so a register is visible
# as one at every use. The input side is not checked -- demanding a _d on
# every load forced filler signals on input registers, pipeline stages, RAM
# reads and synchroniser chains. Indexed writes are memories. A registered
# output keeps its _o: lowRISC does not carry _q to the module boundary.
# An active-low flop is _nq (NAM-003: _n first).
dff-name-style=input:;output:q,nq;waive_lhs_regex:(?i)(mem.*|.*\[.*|.*_o);waive_ifs_with_conditions:!rst_ni,!rst_src_ni,!rst_dst_ni,flush_i,!rst_ni || flush_i,flush_i || !rst_ni
enum-name-style=style_regex:[a-z_0-9]+(_e|_t)
interface-name-style=style_regex:[a-z_0-9]+(_if)
struct-union-name-style
parameter-name-style=localparam_style:CamelCase|ALL_CAPS;parameter_style:CamelCase
parameter-type-name-style
macro-name-style=style_regex:[A-Z_0-9]+
positive-meaning-parameter-name

# --- structure / layout ---
explicit-begin=if_enable:true;else_enable:true;always_enable:true;always_comb_enable:true;always_latch_enable:true;always_ff_enable:true;for_enable:true;forever_enable:true;foreach_enable:true;while_enable:true;initial_enable:true
line-length=length:100
no-tabs
no-trailing-spaces
posix-eof
one-module-per-file
module-filename
package-filename
module-begin-block
mismatched-labels
endif-comment

# --- instantiation / parameters ---
# svstyle's PRT-003 / PRT-005 cover every instance, not only those with two or more
-module-port
-module-parameter
forbid-defparam
explicit-parameter-storage-type
proper-parameter-declaration=package_allow_parameter:false;package_allow_localparam:true

# --- generate ---
generate-label
generate-label-prefix
legacy-generate-region
legacy-genvar-declaration
v2001-generate-begin

# --- types ---
typedef-enums
typedef-structs-unions
packed-dimensions-range-ordering
unpacked-dimensions-range-ordering

# --- literals / expressions ---
truncated-numeric-literal
undersized-binary-literal
suggest-parentheses
forbid-negative-array-dim
numeric-format-string-style
forbid-consecutive-null-statements
forbid-line-continuations
suspicious-semicolon
macro-string-concatenation

# --- functions / tasks in packages ---
explicit-function-lifetime
explicit-task-lifetime
explicit-function-task-parameter-type
invalid-system-task-function

# --- explicitly off: broken in this build ---
# instance-shadowing false-positives on every typedef'd type used as a
# declaration type and on every `.port` named connection. Unusable.
-instance-shadowing

# --- explicitly off: DV-only, not our scope ---
-constraint-name-style
-create-object-name-match
-disable-statement
-forbidden-macro
-plusarg-assignment
-uvm-macro-semicolon
-void-cast

# --- explicitly off: no observable effect in this build ---
-banned-declared-name-patterns
